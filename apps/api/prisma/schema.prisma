// ============================================================================
// NEFROPROTECCIÓN (Ruta v7.2). Tablas escritas a partir de los contratos de la API que el prototipo usaba en su
// «modo base de datos» (PostgREST: paciente, laboratorio, valoracion, atencion, novedad, contacto_gestion,
// eps_modelo_atencion y las funciones guardar_paciente, registrar_valoracion, importar_libro y congelar_corte).
// La agenda (jornadas, citas, bitácora y contactos), que el prototipo aún no guardaba en la base, se guarda en
// nefro_agenda_fila con las mismas columnas de sus hojas de Excel.
// ============================================================================

/// Paciente de la Ruta de Nefroprotección. La identidad compartida vive en «persona» (D1).
model NefroPaciente {
  id                String    @id @default(uuid()) @db.Uuid
  codigo            String    @unique
  personaId         String    @unique @map("persona_id") @db.Uuid
  nombreCompleto    String    @map("nombre_completo")
  telefono2         String?   @map("telefono_2")
  correo            String?
  acudienteNombre   String?   @map("acudiente_nombre")
  acudienteTelefono String?   @map("acudiente_telefono")
  fechaIngreso      DateTime? @map("fecha_ingreso") @db.Date
  hta               Boolean?
  diabetes          String?
  enfCardiovascular Boolean?  @map("enf_cardiovascular")
  causaErc          String?   @map("causa_erc")
  situacionRenal    String?   @map("situacion_renal")
  estado            String    @default("ACTIVO")
  fechaEstado       DateTime? @map("fecha_estado") @db.Date
  observaciones     String?
  creadoPor         String?   @map("creado_por") @db.Uuid
  creadoEn          DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoPor    String?   @map("actualizado_por") @db.Uuid
  actualizadoEn     DateTime  @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  persona      Persona            @relation(fields: [personaId], references: [id])
  laboratorios NefroLaboratorio[]
  valoraciones NefroValoracion[]
  atenciones   NefroAtencion[]
  novedades    NefroNovedad[]
  contactos    NefroContacto[]

  @@map("nefro_paciente")
}

/// Paraclínico. No puede repetirse el mismo examen en la misma fecha para el paciente (salvo anulado).
model NefroLaboratorio {
  id              String    @id @default(uuid()) @db.Uuid
  pacienteId      String    @map("paciente_id") @db.Uuid
  fechaToma       DateTime  @map("fecha_toma") @db.Date
  examen          String
  valor           Float
  anulado         Boolean   @default(false)
  motivoAnulacion String?   @map("motivo_anulacion")
  creadoPor       String?   @map("creado_por") @db.Uuid
  creadoEn        DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  anuladoPor      String?   @map("anulado_por") @db.Uuid
  anuladoEn       DateTime? @map("anulado_en") @db.Timestamptz(3)

  paciente NefroPaciente @relation(fields: [pacienteId], references: [id])

  @@index([pacienteId, fechaToma])
  @@map("nefro_laboratorio")
}

/// Valoración con su clasificación, metas y nota (datos: todos los campos que envía la herramienta).
model NefroValoracion {
  id              String    @id @default(uuid()) @db.Uuid
  pacienteId      String    @map("paciente_id") @db.Uuid
  fecha           DateTime  @db.Date
  datos           Json
  anulado         Boolean   @default(false)
  motivoAnulacion String?   @map("motivo_anulacion")
  creadoPor       String?   @map("creado_por") @db.Uuid
  creadoEn        DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  anuladoPor      String?   @map("anulado_por") @db.Uuid
  anuladoEn       DateTime? @map("anulado_en") @db.Timestamptz(3)

  paciente NefroPaciente   @relation(fields: [pacienteId], references: [id])
  plan     NefroPlanItem[]

  @@index([pacienteId, fecha])
  @@map("nefro_valoracion")
}

/// Ítem del plan de intervenciones generado en una valoración.
model NefroPlanItem {
  id           String @id @default(uuid()) @db.Uuid
  valoracionId String @map("valoracion_id") @db.Uuid
  orden        Int
  datos        Json

  valoracion NefroValoracion @relation(fields: [valoracionId], references: [id])

  @@index([valoracionId])
  @@map("nefro_plan_item")
}

model NefroAtencion {
  id              String    @id @default(uuid()) @db.Uuid
  pacienteId      String    @map("paciente_id") @db.Uuid
  fecha           DateTime  @db.Date
  disciplina      String
  estado          String?
  anulado         Boolean   @default(false)
  motivoAnulacion String?   @map("motivo_anulacion")
  creadoPor       String?   @map("creado_por") @db.Uuid
  creadoEn        DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  anuladoPor      String?   @map("anulado_por") @db.Uuid
  anuladoEn       DateTime? @map("anulado_en") @db.Timestamptz(3)

  paciente NefroPaciente @relation(fields: [pacienteId], references: [id])

  @@index([pacienteId, fecha])
  @@map("nefro_atencion")
}

model NefroNovedad {
  id         String   @id @default(uuid()) @db.Uuid
  pacienteId String   @map("paciente_id") @db.Uuid
  fecha      DateTime @db.Date
  tipo       String
  detalle    String?
  creadoPor  String?  @map("creado_por") @db.Uuid
  creadoEn   DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  paciente NefroPaciente @relation(fields: [pacienteId], references: [id])

  @@index([pacienteId, fecha])
  @@map("nefro_novedad")
}

/// Gestión de contacto (llamadas, mensajes) registrada desde la ficha del paciente.
model NefroContacto {
  id            String    @id @default(uuid()) @db.Uuid
  pacienteId    String    @map("paciente_id") @db.Uuid
  fechaHora     DateTime  @default(now()) @map("fecha_hora") @db.Timestamptz(3)
  medio         String
  resultado     String
  citaFecha     DateTime? @map("cita_fecha") @db.Date
  motivo        String?
  observaciones String?
  creadoPor     String?   @map("creado_por") @db.Uuid

  paciente NefroPaciente @relation(fields: [pacienteId], references: [id])

  @@index([pacienteId])
  @@map("nefro_contacto")
}

/// Modelo de atención por EPS, versionado: el vigente es el último de cada EPS.
model EpsModeloAtencion {
  id                      String   @id @default(uuid()) @db.Uuid
  epsId                   Int      @map("eps_id")
  contactoIntermedio      String?  @map("contacto_intermedio")
  contactoMeses           Int?     @map("contacto_meses")
  ajusteMetasPor          String?  @map("ajuste_metas_por")
  multidisciplinario      String?
  medicamentosContratados Boolean? @map("medicamentos_contratados")
  observaciones           String?
  vigenteDesde            DateTime @default(now()) @map("vigente_desde") @db.Timestamptz(3)
  creadoPor               String?  @map("creado_por") @db.Uuid

  eps Eps @relation(fields: [epsId], references: [id])

  @@index([epsId, vigenteDesde])
  @@map("eps_modelo_atencion")
}

/// Corte congelado de indicadores (resumen y detalle por paciente) para trazabilidad de los reportes.
model NefroCorte {
  id         String   @id @default(uuid()) @db.Uuid
  fechaCorte DateTime @map("fecha_corte") @db.Date
  version    String?
  resumen    Json
  detalle    Json
  creadoPor  String?  @map("creado_por") @db.Uuid
  creadoEn   DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@map("nefro_corte")
}

/// Agenda de la Ruta: filas de las hojas Jornadas, Citas, Citas_log y Contactos, con sus mismas columnas.
model NefroAgendaFila {
  hoja           String
  clave          String
  datos          Json
  creadoPor      String?  @map("creado_por") @db.Uuid
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoPor String?  @map("actualizado_por") @db.Uuid
  actualizadoEn  DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  @@id([hoja, clave])
  @@map("nefro_agenda_fila")
}
