# Copie este archivo como .env para desarrollo local. NUNCA suba .env al repositorio.

# Base de datos (docker compose expone Postgres en el puerto 5433)
DATABASE_URL="postgresql://posmedica:posmedica_local@localhost:5433/posmedica?schema=public"

NODE_ENV=development
PORT=4000

# Secreto para firmar los hashes de las sesiones. En Render se genera solo (generateValue).
# Local: cualquier texto largo y aleatorio (mínimo 32 caracteres).
SESSION_SECRET=cambie-esto-por-un-texto-largo-y-aleatorio-de-al-menos-32

# Orígenes permitidos para peticiones que modifican datos (coma entre varios).
# Local: el servidor de Vite. Render: la URL del Static Site (https://posmedica-web.onrender.com).
ALLOWED_ORIGINS=http://localhost:5173

# Saltos de proxy de confianza para conocer la IP real (Render: 2 = proxy del Static Site + balanceador).
TRUST_PROXY_HOPS=0

# Minutos de inactividad antes de cerrar la sesión y horas máximas de una sesión.
SESSION_IDLE_MIN=30
SESSION_MAX_HOURS=12

# Primer administrador. Solo se usa si la tabla de usuarios está vacía.
# La clave inicial se debe cambiar en el primer ingreso.
ADMIN_USUARIO=admin
ADMIN_NOMBRE=Administrador del sistema
ADMIN_CARGO=Coordinación asistencial
ADMIN_CLAVE_INICIAL=CambieEsta2026!
