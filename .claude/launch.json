{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "apps/api"
      ],
      "port": 4000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "apps/web"
      ],
      "port": 5173
    },
    {
      "name": "api-e2e",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:e2e",
        "-w",
        "apps/api"
      ],
      "port": 4001
    },
    {
      "name": "web-e2e",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:e2e",
        "-w",
        "apps/web"
      ],
      "port": 5174
    }
  ]
}
